rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "YOUR_EMAIL@gmail.com"
        && request.auth.token.email_verified == true;
    }

    match /{path=**} {
      allow read, write: if isOwner();
    }
  }
}
